# TeleAgent Multi-Tenant AI Telegram Agent Builder
# Master Production Configuration Template

# Node Environment
NODE_ENV=production
PORT=3001

# Production PostgreSQL Database Connection
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=

# Cryptographic Session & Secret Keys (Generate with `openssl rand -hex 32`)
SESSION_SECRET=
CREDENTIAL_ENCRYPTION_KEY=

# Public URLs
FRONTEND_URL=https://app.yourdomain.com
CORS_ORIGIN=https://app.yourdomain.com

# Frontend API URL (for Vite build)
VITE_API_URL=https://api.yourdomain.com
