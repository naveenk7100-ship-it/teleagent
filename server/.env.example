# TeleAgent Production Backend Environment Configuration
# NEVER commit real secrets or production keys to version control.

# Server Environment
NODE_ENV=production
PORT=3001

# Production PostgreSQL Database Connection
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=

# Cryptographic Session & Token Secrets
# Generate a 64-character random hex string: openssl rand -hex 32
SESSION_SECRET=

# AES-256-GCM Secret Encryption Key (32-byte / 64-hex string)
# Used to encrypt Telegram Bot Tokens and AI Provider Keys at rest in database
CREDENTIAL_ENCRYPTION_KEY=

# Public Client Frontend URL (Used for Strict CORS and Auth Redirects)
# Format: https://app.yourdomain.com
FRONTEND_URL=

# CORS Allowed Origins (Comma-separated list)
# Format: https://app.yourdomain.com,https://dashboard.yourdomain.com
CORS_ORIGIN=

# Optional: Default AI Provider Key (fallback if tenant has not configured their own)
# GEMINI_API_KEY=
